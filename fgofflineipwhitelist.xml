<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_FGOFFLINEIPWHITELIST</name>
    <author>FG</author>
    <creationDate>2026-08-10</creationDate>
    <copyright>(C) FG</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <version>1.0.9</version>
    <description>PLG_SYSTEM_FGOFFLINEIPWHITELIST_XML_DESCRIPTION</description>
    <namespace path="src">FG\Plugin\System\Fgofflineipwhitelist</namespace>

    <updateservers>
        <server type="extension" priority="1" name="System - FG Offline IP Whitelist Update Site">https://raw.githubusercontent.com/ferino75/plg_system_fgofflineipwhitelist/master/updates.xml</server>
    </updateservers>

    <files>
        <folder plugin="fgofflineipwhitelist">services</folder>
        <folder>src</folder>
        <folder>fields</folder>
        <folder>language</folder>
    </files>

    <languages>
        <language tag="en-GB">language/en-GB/plg_system_fgofflineipwhitelist.ini</language>
        <language tag="en-GB">language/en-GB/plg_system_fgofflineipwhitelist.sys.ini</language>
        <language tag="sk-SK">language/sk-SK/plg_system_fgofflineipwhitelist.ini</language>
        <language tag="sk-SK">language/sk-SK/plg_system_fgofflineipwhitelist.sys.ini</language>
    </languages>

    <config>
        <fields name="params" addfieldpath="/plugins/system/fgofflineipwhitelist/fields">
            <fieldset name="basic">
                <field
                    name="detected_ip"
                    type="fgclientip"
                    label="PLG_SYSTEM_FGOFFLINEIPWHITELIST_FIELD_DETECTED_IP_LABEL"
                    description="PLG_SYSTEM_FGOFFLINEIPWHITELIST_FIELD_DETECTED_IP_DESC"
                />

                <field
                    name="allowed_ips"
                    type="textarea"
                    label="PLG_SYSTEM_FGOFFLINEIPWHITELIST_FIELD_ALLOWED_IPS_LABEL"
                    description="PLG_SYSTEM_FGOFFLINEIPWHITELIST_FIELD_ALLOWED_IPS_DESC"
                    rows="6"
                    filter="raw"
                />

                <field
                    name="trust_xff"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="PLG_SYSTEM_FGOFFLINEIPWHITELIST_FIELD_TRUST_XFF_LABEL"
                    description="PLG_SYSTEM_FGOFFLINEIPWHITELIST_FIELD_TRUST_XFF_DESC"
                    default="0"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="trusted_proxies"
                    type="textarea"
                    label="PLG_SYSTEM_FGOFFLINEIPWHITELIST_FIELD_TRUSTED_PROXIES_LABEL"
                    description="PLG_SYSTEM_FGOFFLINEIPWHITELIST_FIELD_TRUSTED_PROXIES_DESC"
                    rows="4"
                    filter="raw"
                    showon="trust_xff:1"
                />

                <field
                    name="ip_header"
                    type="list"
                    label="PLG_SYSTEM_FGOFFLINEIPWHITELIST_FIELD_IP_HEADER_LABEL"
                    description="PLG_SYSTEM_FGOFFLINEIPWHITELIST_FIELD_IP_HEADER_DESC"
                    default="x_forwarded_for"
                    showon="trust_xff:1"
                >
                    <option value="x_forwarded_for">PLG_SYSTEM_FGOFFLINEIPWHITELIST_FIELD_IP_HEADER_OPT_XFF</option>
                    <option value="cf_connecting_ip">PLG_SYSTEM_FGOFFLINEIPWHITELIST_FIELD_IP_HEADER_OPT_CF</option>
                    <option value="true_client_ip">PLG_SYSTEM_FGOFFLINEIPWHITELIST_FIELD_IP_HEADER_OPT_TCI</option>
                </field>

                <field
                    name="log_access"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="PLG_SYSTEM_FGOFFLINEIPWHITELIST_FIELD_LOG_ACCESS_LABEL"
                    description="PLG_SYSTEM_FGOFFLINEIPWHITELIST_FIELD_LOG_ACCESS_DESC"
                    default="0"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
